# Script mode (cmake -P). Inputs: INPUTS ('|'-separated paths), OUTPUT (header path).
#
# Each shader becomes one string_view built from SEVERAL adjacent raw string literals: MSVC
# rejects a single literal longer than 16 380 bytes (error C2026), and the compiler joins
# adjacent literals into one string anyway. 8000-byte pieces stay well below that limit; the
# joined string may be up to ~64 KB on MSVC, which is checked here instead of failing obscurely.
string(REPLACE "|" ";" inputs "${INPUTS}")

set(chunk_size 8000)
set(max_size 60000)

set(content "// Generated by cmake/EmbedShadersScript.cmake. Do not edit.\n")
string(APPEND content "#pragma once\n\n#include <string_view>\n\nnamespace orbis::shaders {\n")

foreach(path IN LISTS inputs)
    get_filename_component(name "${path}" NAME)          # terrain.vert
    string(MAKE_C_IDENTIFIER "${name}" identifier)       # terrain_vert
    file(READ "${path}" source)
    string(LENGTH "${source}" length)
    if(length GREATER max_size)
        message(FATAL_ERROR "${name} is ${length} bytes; split it (MSVC limits a string to ~64 KB)")
    endif()

    string(APPEND content "\ninline constexpr std::string_view ${identifier} =")
    set(offset 0)
    while(offset LESS length)
        string(SUBSTRING "${source}" ${offset} ${chunk_size} piece)
        string(APPEND content "\n    R\"ORBIS_GLSL(${piece})ORBIS_GLSL\"")
        math(EXPR offset "${offset} + ${chunk_size}")
    endwhile()
    if(length EQUAL 0)
        string(APPEND content " \"\"")
    endif()
    string(APPEND content ";\n")
endforeach()

string(APPEND content "\n} // namespace orbis::shaders\n")
file(WRITE "${OUTPUT}" "${content}")
