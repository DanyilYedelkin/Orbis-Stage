# Script mode (cmake -P). Inputs: INPUTS ('|'-separated paths), OUTPUT (header path).
string(REPLACE "|" ";" inputs "${INPUTS}")

set(content "// Generated by cmake/EmbedShadersScript.cmake. Do not edit.\n")
string(APPEND content "#pragma once\n\n#include <string_view>\n\nnamespace orbis::shaders {\n")

foreach(path IN LISTS inputs)
    get_filename_component(name "${path}" NAME)          # terrain.vert
    string(MAKE_C_IDENTIFIER "${name}" identifier)       # terrain_vert
    file(READ "${path}" source)
    string(APPEND content "\ninline constexpr std::string_view ${identifier} = R\"ORBIS_GLSL(${source})ORBIS_GLSL\";\n")
endforeach()

string(APPEND content "\n} // namespace orbis::shaders\n")
file(WRITE "${OUTPUT}" "${content}")
