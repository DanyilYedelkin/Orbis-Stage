// Precomputes the sky irradiance table once at startup: for every (altitude, sun angle), the
// light a HORIZONTAL surface receives from the whole sky (not from the sun disk), for a sun of
// illuminance 1:  E = integral over the upper hemisphere of L(w) cos(theta) dw.
//
// Cosine-weighted stratified directions turn this into E = pi * mean(L). Each view ray is
// integrated like the sky itself: single scattering with the real phase functions plus, when
// uMultipleScattering is set, Hillaire's multiple-scattering term. With it unset the result is
// pure single scattering - exactly what skyIrradianceSingleScattering() computes on the CPU, so
// the startup check can compare the two.
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;
uniform int uMultipleScattering;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, ivec2(kIrradianceSize)))) {
        return;
    }
    // Same texel -> (r, muSun) mapping as irradianceTexelToRMu() in AtmosphereModel.cpp.
    float muSun = -1.0 + 2.0 * float(texel.x) / (kIrradianceSize.x - 1.0);
    float r = kBottomRadius + 0.001 +
              (kTopRadius - kBottomRadius - 0.002) * float(texel.y) / (kIrradianceSize.y - 1.0);
    vec3 origin = vec3(0.0, 0.0, r);
    vec3 sun = vec3(sqrt(max(1.0 - muSun * muSun, 0.0)), 0.0, muSun);

    vec3 sum = vec3(0.0);
    for (int i = 0; i < kIrradianceZenithSamples; ++i) {
        float u1 = (float(i) + 0.5) / float(kIrradianceZenithSamples);
        float sinTheta = sqrt(u1);
        float cosTheta = sqrt(1.0 - u1);
        for (int j = 0; j < kIrradianceAzimuthSamples; ++j) {
            float phi = 2.0 * kPi * (float(j) + 0.5) / float(kIrradianceAzimuthSamples);
            vec3 dir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
            float cosView = dot(dir, sun);
            float phaseR = rayleighPhase(cosView);
            float phaseM = miePhase(cosView);
            float len = distanceToTop(r, cosTheta);

            vec3 luminance = vec3(0.0);
            vec3 throughput = vec3(1.0);
            float previous = 0.0;
            for (int s = 0; s < kIrradianceSteps; ++s) {
                float x = (float(s) + 1.0) / float(kIrradianceSteps);
                float t = len * x * x;
                float dt = t - previous;
                vec3 p = origin + dir * (0.5 * (t + previous));
                previous = t;
                float radius = length(p);
                float mu = dot(p, sun) / radius;
                Medium m = mediumAt(radius - kBottomRadius);
                vec3 scattering = (m.rayleigh * phaseR + m.mie * phaseM) * sunTransmittance(radius, mu);
                if (uMultipleScattering != 0) {
                    scattering += (m.rayleigh + m.mie) * multipleScattering(radius, mu);
                }
                vec3 stepTransmittance = exp(-m.extinction * dt);
                luminance += throughput * (scattering - scattering * stepTransmittance) /
                             max(m.extinction, vec3(1e-9));
                throughput *= stepTransmittance;
            }
            sum += luminance;
        }
    }
    float samples = float(kIrradianceZenithSamples * kIrradianceAzimuthSamples);
    imageStore(uOutput, texel, vec4(sum * (kPi / samples), 1.0));
}
